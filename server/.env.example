# 本地多用户开发。APP_ORIGIN 必须匹配 Vite 实际地址。
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://localhost/infinite_canvas
# 仅测试需要，必须是独立且以 _test 结尾的数据库。
# TEST_DATABASE_URL=postgresql://localhost/infinite_canvas_test
RATE_LIMIT_SECRET=replace-with-random-secret
# 32 字节 base64 密钥，用于 AES-256-GCM 加密账号 Key，首次设置后不要随意更换。
CREDENTIALS_ENCRYPTION_KEY=replace-with-32-byte-base64
CATALOG_CONFIG_PATH=./config/catalog.json
# 默认媒体保存在 server/data/media，不需要 MinIO。
# 配置全部字段后启用 MinIO，桶需预先创建。
# MINIO_ENDPOINT=127.0.0.1
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=infinite-canvas
# 密码重置邮件。五项齐备才启用；缺任一项时重置接口返回 503，登录注册不受影响。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=
# MAIL_FROM=无限画布 <no-reply@example.com>
