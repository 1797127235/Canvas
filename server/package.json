{
    "name": "infinite-canvas-server",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.14",
    "engines": {
        "node": ">=24.18.0 <25"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
        "typecheck": "tsc --noEmit",
        "build": "tsc --outDir dist",
        "start": "node dist/src/index.js"
    },
    "dependencies": {
        "argon2": "0.45.1",
        "cookie": "0.7.2",
        "express": "5.2.1",
        "helmet": "8.3.0",
        "minio": "8.0.7",
        "pg": "8.23.1",
        "rate-limiter-flexible": "11.2.1",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@types/express": "5.0.6",
        "@types/node": "24.19.1",
        "@types/pg": "8.23.1",
        "tsx": "4.23.15",
        "typescript": "5.9.3"
    },
    "trustedDependencies": []
}
