# 生产部署配置：复制为同目录 .env 后填写；.env 已被 .gitignore 排除，不会进入版本库。
# docker compose 读取本文件做变量替换，api 容器同时注入其中的 NODE_ENV/HOST/PORT/APP_ORIGIN 等变量。

# 浏览器实际访问地址（含端口）。写请求按来源校验，必须与地址栏完全一致，否则后端返回 403。
APP_ORIGIN=http://192.168.6.78:3015

# 前端对外端口
WEB_PORT=3015

# 镜像标签：每次升级换成新的版本号或提交号，回滚时把 IMAGE_TAG 改回旧值再 up -d。
IMAGE_TAG=local

# PostgreSQL 密码，替换成长随机串（如 openssl rand -hex 24 生成）。
POSTGRES_PASSWORD=change-me-to-long-random

# 32 字节 base64 密钥，AES-256-GCM 加密账号 API Key。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 首次设置后不能再更换；丢失将无法解密已保存的账号 Key，务必在服务器之外留存一份。
CREDENTIALS_ENCRYPTION_KEY=

# 登录/注册限流签名，任意随机串（如 openssl rand -hex 32）。
RATE_LIMIT_SECRET=

# 上游目录配置，所有模型共用其中的 baseUrl，账号 Key 用于该上游的模型发现。
# compose 已把 server/config/catalog.json 挂载为容器内该路径，保持默认即可。
CATALOG_CONFIG_PATH=/app/server/config/catalog.json

# 后端容器环境，保持默认即可。
NODE_ENV=production
HOST=0.0.0.0
PORT=4100

# 可选：五个字段全部配置后媒体改存 MinIO（桶需预先创建）；默认存命名卷 media_data。
#MINIO_ENDPOINT=
#MINIO_PORT=9000
#MINIO_ACCESS_KEY=
#MINIO_SECRET_KEY=
#MINIO_BUCKET=infinite-canvas
